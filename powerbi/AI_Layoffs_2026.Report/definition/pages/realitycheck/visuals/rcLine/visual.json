                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.US Monthly Layoffs"
          }
        }
      ],
      "legend": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
